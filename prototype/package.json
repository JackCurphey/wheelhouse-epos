{
  "name": "wheelhouse-workshop-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.*",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "test:browser:install": "node tests/browser/install-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
