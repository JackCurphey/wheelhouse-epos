{
  "name": "bike-shop-epos",
  "version": "1.0.0",
  "description": "Local EPOS system for a bike shop - till, inventory, sales history and dashboard. Backed by PostgreSQL - one dependency (pg), see README for local setup.",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "prototype": "npm --prefix prototype run dev",
    "prototype:build": "npm --prefix prototype run build",
    "prototype:test": "npm --prefix prototype test",
    "prototype:test:browser": "npm --prefix prototype run test:browser",
    "prototype:browser:install": "npm --prefix prototype run test:browser:install",
    "gateway": "node server/gateway.js",
    "migrate": "node server/migrations/run-migrations.js",
    "pretest": "vite build --config vite.test.config.ts --logLevel warn && vite build --config vite.registry-test.config.ts --logLevel warn",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "registry:build": "shadcn build registry/registry.json --output public/r",
    "registry:validate": "shadcn registry validate registry/registry.json",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "30.0.1",
    "lucide-react": "^1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "4.19.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
