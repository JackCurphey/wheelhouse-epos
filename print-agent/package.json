{
  "name": "wheelhouse-print-agent",
  "version": "1.0.0",
  "description": "Downloadable background app that gives the Wheelhouse EPOS sticker-printing feature real printer access - runs on any shop PC, never inside Docker.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.wheelhouse.print-agent",
    "productName": "Wheelhouse Print Agent",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "print-label.ps1", "package.json"]
  },
  "devDependencies": {
    "electron": "^32",
    "electron-builder": "^25"
  }
}
